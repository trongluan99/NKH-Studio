<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_native"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_color="#E2E8F0"
    app:shimmer_colored="false"
    app:shimmer_duration="1200"
    app:shimmer_highlight_color="#F8FAFC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_native_card_light"
        android:padding="12dp">

        <!-- Shimmer Icon Placeholder -->
        <View
            android:id="@+id/shimmer_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_shimmer_item"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Shimmer "Ad" Badge Placeholder -->
        <View
            android:id="@+id/shimmer_badge"
            android:layout_width="22dp"
            android:layout_height="14dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_shimmer_item"
            app:layout_constraintStart_toEndOf="@id/shimmer_icon"
            app:layout_constraintTop_toTopOf="@id/shimmer_icon" />

        <!-- Shimmer Headline Placeholder -->
        <View
            android:id="@+id/shimmer_headline"
            android:layout_width="160dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_shimmer_item"
            app:layout_constraintBottom_toBottomOf="@id/shimmer_badge"
            app:layout_constraintStart_toEndOf="@id/shimmer_badge"
            app:layout_constraintTop_toTopOf="@id/shimmer_badge" />

        <!-- Shimmer Advertiser Placeholder -->
        <View
            android:id="@+id/shimmer_advertiser"
            android:layout_width="100dp"
            android:layout_height="12dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_shimmer_item"
            app:layout_constraintStart_toEndOf="@id/shimmer_icon"
            app:layout_constraintTop_toBottomOf="@id/shimmer_badge" />

        <!-- Shimmer Body Text Line 1 -->
        <View
            android:id="@+id/shimmer_body_1"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_shimmer_item"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmer_icon" />

        <!-- Shimmer Body Text Line 2 -->
        <View
            android:id="@+id/shimmer_body_2"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/bg_shimmer_item"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmer_body_1" />

        <!-- Shimmer MediaView Placeholder (Exact 160dp) -->
        <View
            android:id="@+id/shimmer_media"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shimmer_item"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmer_body_2" />

        <!-- Shimmer CTA Button Placeholder (Exact 44dp) -->
        <View
            android:id="@+id/shimmer_cta"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_shimmer_item"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shimmer_media" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
